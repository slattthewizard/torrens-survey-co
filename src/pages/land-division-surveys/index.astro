    </div>
    <div class="hero-img" style="border-radius:12px;overflow:hidden;box-shadow:0 24px 48px rgba(0,0,0,0.3);">
      <img src="/images/service-3.webp" alt="Subdivision Adelaide: Land Division and Subdivision Surveys" width="800" height="533" style="width:100%;height:100%;object-fit:cover;display:block;" loading="eager" fetchpriority="high">
